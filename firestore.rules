rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidServiceRequest(data) {
      return data.keys().hasAll(['name', 'phone', 'zipCode', 'serviceType', 'status'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 25
        && data.zipCode is string && data.zipCode.size() >= 5 && data.zipCode.size() <= 10
        && data.serviceType is string && data.serviceType.size() <= 50
        && data.status is string && (data.status == 'new' || data.status == 'contacted' || data.status == 'scheduled' || data.status == 'completed')
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('message' in data) || (data.message is string && data.message.size() <= 1000))
        && (!('urgency' in data) || (data.urgency is string && data.urgency.size() <= 30))
        && (!('preferredTime' in data) || (data.preferredTime is string && data.preferredTime.size() <= 50));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['customerName', 'city', 'rating', 'reviewText'])
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 60
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 60
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.reviewText is string && data.reviewText.size() >= 10 && data.reviewText.size() <= 1000
        && (!('service' in data) || (data.service is string && data.service.size() <= 60))
        && (!('verified' in data) || (data.verified is bool));
    }

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid == uid
        && data.email is string && data.email.size() <= 100
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100));
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection endpoint for initial verification
    match /test/connection {
      allow read: if true;
    }

    // Service Requests (Lead Generation)
    match /serviceRequests/{requestId} {
      allow create: if isValidId(requestId)
        && isValidServiceRequest(incoming())
        && incoming().status == 'new'
        && (!('userId' in incoming()) || (isSignedIn() && incoming().userId == request.auth.uid));

      allow get: if isSignedIn() && (
        (resource != null && 'userId' in resource.data && resource.data.userId == request.auth.uid)
      );

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && isValidId(requestId)
        && isValidServiceRequest(incoming())
        && resource.data.userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'message', 'preferredTime']);

      allow delete: if false;
    }

    // Verified Reviews & Ratings
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update, delete: if false;
    }

    // Homeowner User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
      allow delete: if false;
    }
  }
}
